  "categorical_features": [
    "breed",
    "breed_group",
    "sex",
    "lactation_stage",
    "feed_type",
    "health_status",
    "disease_status",
    "disease_type",
    "symptoms",
    "vaccination_status",
    "treatment_status",
    "weather_condition",
    "season"
  ],
  "train_file": "LactoVision_Train_40000.csv",
  "test_file": "LactoVision_Test_10000.csv",
  "train_rows": 40000,
  "test_rows": 10000,
  "train_unique_cows": 160,
  "test_unique_cows": 40,
  "train_test_cow_overlap": 0,
  "python_version": "3.13.2",
  "scikit_learn_version": "1.8.0",
  "pandas_version": "2.2.3",
  "numpy_version": "2.3.5",
  "note": "Test set is used only for final evaluation, never for model fitting. Dataset is synthetic."
