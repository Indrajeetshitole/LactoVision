    "days_since_calving",
    "feed_type",
    "feed_quantity_kg_dm",
    "feed_frequency",
    "morning_feed_kg",
    "afternoon_feed_kg",
    "evening_feed_kg",
    "feed_quality_score",
    "dry_matter_kg",
    "crude_protein_g",
    "metabolizable_energy_mj",
    "ndf_g",
    "fat_g",
    "calcium_g",
    "phosphorus_g",
    "water_intake_l",
    "body_condition_score",
    "health_status",
    "disease_status",
    "disease_type",
    "symptoms",
    "vaccination_status",
    "treatment_status",
    "body_temperature_c",
    "heart_rate_bpm",
    "respiration_rate_bpm",
    "ambient_temperature_c",
    "relative_humidity_pct",
    "thi",
    "weather_condition",
    "season"
  ],
  "excluded_identifiers": [
    "record_id",
    "source_dataset",
    "source_record_id",
    "cow_id",
    "farm_id",
    "record_date"
  ],
  "excluded_leakage_columns": [
    "daily_milk_yield_kg",
    "milk_morning_kg",
    "milk_evening_kg",
    "daily_revenue",
    "daily_profit",
    "feed_cost_per_kg_milk"
